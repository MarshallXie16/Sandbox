# Engagement Tracker Database
# Use PostgreSQL in production, SQLite for development
DATABASE_URL=postgresql://user:password@localhost:5432/engagement_tracker
# Alternative for development:
# DATABASE_URL=sqlite:///./engagement_tracker.db

# IndieStack CRM Core Integration
# Option 1: Direct database access
INDIE_CRM_DB_URL=postgresql://user:password@localhost:5432/indie_crm_core
# Option 2: API access (if available)
INDIE_CRM_API_URL=http://localhost:8000/api
INDIE_CRM_API_KEY=your_api_key_here

# Capital Ink Hub Email Engine Integration
EMAIL_ENGINE_DB_URL=postgresql://user:password@localhost:5432/capitalinkhub_email

# Optional: Future integrations
HUBSPOT_API_KEY=
SENDY_API_URL=
SENDY_API_KEY=

# Scoring Configuration
DEFAULT_SCORING_PROFILE_ID=1
SCORE_DECAY_ENABLED=true
SCORE_DECAY_DAYS=90
SCORE_DECAY_FACTOR=0.5

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001

# Security
API_SECRET_KEY=your_secret_key_here_change_in_production
