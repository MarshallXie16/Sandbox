# Application
APP_NAME=Exit Ready Automation
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database - Exit Ready
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/exit_ready
# Alternative: separate schema in shared DB
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/indiestack?options=-csearch_path=exit_ready

# Database - CRM Core (read-only access)
CRM_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/indiestack
# If same DB, can be same as DATABASE_URL

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Valuation Engine Integration
VALUATION_ENGINE_BASE_URL=https://api.capitallink.com/valuation/v1
VALUATION_ENGINE_API_KEY=your_api_key_here
VALUATION_ENGINE_TIMEOUT=30
VALUATION_ENGINE_STUB_MODE=true

# Email Engine Integration
EMAIL_ENGINE_BASE_URL=https://api.capitallink.com/email/v1
EMAIL_ENGINE_API_KEY=your_api_key_here
EMAIL_ENGINE_TIMEOUT=30
EMAIL_ENGINE_STUB_MODE=true

# File Storage
# Local development
STORAGE_TYPE=local
STORAGE_BASE_PATH=./storage
# Production (S3)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_BUCKET_NAME=exit-ready-docs
# AWS_REGION=us-east-1

# Intake Form
INTAKE_FORM_BASE_URL=https://forms.capitallink.com/exit-ready
INTAKE_FORM_TTL_DAYS=30

# PDF Generation
PDF_ENGINE=weasyprint
PDF_TEMPLATE_DIR=./config/templates

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-for-authentication

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature Flags
ENABLE_AUTO_VALUATION=false
ENABLE_GPT_DRAFTS=false
GPT_API_KEY=
GPT_MODEL=gpt-4-turbo-preview
