# ========================================
# VaultAI Integration Layer Configuration
# ========================================

# General Settings
VAULTAI_ENV=dev
VAULTAI_DEBUG=true
VAULTAI_API_KEYS=vaultai_dev_key_12345,vaultai_admin_key_67890
VAULTAI_HOST=0.0.0.0
VAULTAI_PORT=8010

# Database Configuration
DATABASE_URL=postgresql+asyncpg://vaultai_user:vaultai_password@localhost:5432/vaultai_db

# LLM Provider - Default
LLM_DEFAULT_PROVIDER=local

# LLM Provider - Local Private LLM
LLM_LOCAL_BASE_URL=http://localhost:8009
LLM_LOCAL_MODEL=llama3-70b-instruct
LLM_LOCAL_API_KEY=

# LLM Provider - OpenAI Compatible
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4-turbo-preview

# LLM Provider - Azure (Optional)
LLM_AZURE_BASE_URL=
LLM_AZURE_API_KEY=
LLM_AZURE_MODEL=
LLM_AZURE_API_VERSION=2024-02-01

# LLM Request Settings
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3

# Embeddings Configuration
USE_EMBEDDINGS=true
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=text-embedding-ada-002
EMBEDDINGS_DIMENSION=1536

# Security & Redaction
ENABLE_PII_REDACTION=true
REDACTION_PATTERNS=ssn,email,phone,credit_card

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_RESPONSES=false

# CORS (for optional UI)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Feature Flags
ENABLE_UI=true
ENABLE_VECTOR_SEARCH=true
ENABLE_PROMPT_VERSIONING=true
