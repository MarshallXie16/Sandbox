# Application Configuration
PORTAL_ENV=dev
PORTAL_DEBUG=true
PORTAL_VERSION=0.1.0
LOG_LEVEL=INFO

# Security - API Keys
# Generate with: python portal_cli.py portal create-api-key
PORTAL_API_KEY=your-primary-api-key-here
PORTAL_API_KEYS=additional-key-1,additional-key-2

# Database - IndieStack CRM PostgreSQL
INDIE_DB_DSN=postgresql+asyncpg://user:password@localhost:5432/indie_crm
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Integration URLs (Optional - for future use)
ENGAGEMENT_TRACKER_BASE_URL=
MATCHING_ENGINE_BASE_URL=
ENGAGEMENT_TRACKER_API_KEY=
MATCHING_ENGINE_API_KEY=

# Resources Configuration
PORTAL_RESOURCES_CONFIG_PATH=config/resources.yaml

# CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
