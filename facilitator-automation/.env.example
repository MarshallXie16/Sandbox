# Environment
FACILITATOR_ENV=dev
FACILITATOR_DEBUG=true
LOG_LEVEL=INFO

# API Security
# Comma-separated list of API keys for authentication
FACILITATOR_API_KEYS=your-api-key-here,another-key-here

# Database
# PostgreSQL connection string for Facilitator module
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/facilitator_db

# CRM Integration
# Connection to indie-crm-core database or API
CRM_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crm_db
# Alternative: CRM API endpoint if using API instead of direct DB access
CRM_API_BASE_URL=http://localhost:8001/api/v1
CRM_API_KEY=crm-api-key-here

# Matching Engine Integration (indie-matching-engine)
MATCH_ENGINE_BASE_URL=http://localhost:8002/api/v1
MATCH_ENGINE_API_KEY=matching-engine-api-key-here
MATCH_ENGINE_STUB_MODE=true

# Email Engine Integration (capitalinkhub-email-engine)
EMAIL_ENGINE_BASE_URL=http://localhost:8003/api/v1
EMAIL_ENGINE_API_KEY=email-engine-api-key-here
EMAIL_ENGINE_STUB_MODE=true

# Fee Configuration
# Default offer fee in dollars
DEFAULT_OFFER_FEE_FIXED=5000
# Default success fee rate (0.05 = 5%)
DEFAULT_SUCCESS_FEE_RATE=0.05
# Default currency
DEFAULT_CURRENCY=CAD

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
