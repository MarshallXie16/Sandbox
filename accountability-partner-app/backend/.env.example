# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=GrowthPact
API_VERSION=v1

# Database
DATABASE_URL=postgresql+asyncpg://growthpact:devpassword123@localhost:5432/growthpact_dev

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 (optional for MVP - can skip initially)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=growthpact-uploads-dev

# SendGrid (optional for MVP - can skip initially)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@growthpact.com

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
