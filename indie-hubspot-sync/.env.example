# HubSpot Configuration
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here

# IndieStack Configuration
# Option 1: Direct Database Access
INDIE_DB_HOST=localhost
INDIE_DB_PORT=5432
INDIE_DB_NAME=indie_crm
INDIE_DB_USER=indie_user
INDIE_DB_PASSWORD=your_password_here

# Option 2: API Access (future)
# INDIE_API_URL=https://api.indiestack.local
# INDIE_API_KEY=your_api_key_here

# Integration Mode: 'database' or 'api'
INDIE_INTEGRATION_MODE=database

# Local Tracking Database
SYNC_DB_URL=sqlite:///./sync_tracking.db
# For production, consider PostgreSQL:
# SYNC_DB_URL=postgresql://user:pass@localhost/sync_tracking

# Sync Configuration
DEFAULT_SYNC_DIRECTION=bidirectional  # indie_to_hubspot, hubspot_to_indie, bidirectional
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_RESOLUTION=indie_wins  # indie_wins, hubspot_wins, newest_wins

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
